# Site
PORT=3000
BASE_URL=https://SEU-DOMINIO.com
SESSION_SECRET=troque_por_uma_chave_bem_grande
SITE_DATA_DIR=./data

# Se o site ficar na MESMA host/pasta do bot Discord, aponte para a pasta data dele.
# Assim as salas cadastradas em /salacliente aparecem automaticamente no site.
# Exemplo: CODEPRO_SHARED_DATA_DIR=/home/container/data
CODEPRO_SHARED_DATA_DIR=

# Discord OAuth2
# Application ID público da CodePro Host
DISCORD_CLIENT_ID=1414012731341672458
DISCORD_CLIENT_SECRET=COLOQUE_O_CLIENT_SECRET
DISCORD_REDIRECT_URI=https://SEU-DOMINIO.com/auth/discord/callback

# Donos/admins do site separados por vírgula
ADMIN_DISCORD_IDS=SEU_ID_DO_DISCORD

# Opcionais: reconhecer cargo Cliente e criar webhooks por ID de canal
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
CLIENT_ROLE_ID=
